# UHI Project — Client (Vite) Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.

# ─── Backend API ─────────────────────────────────────────────────────────────────
# In development: http://localhost:3001
# In production:  https://your-backend.onrender.com  (or Railway / Fly.io URL)
VITE_API_URL=http://localhost:3001

# ─── App metadata (optional — used in PWA manifest and page titles) ───────────────
VITE_APP_NAME=UrbanHeatIntelligence
VITE_APP_VERSION=1.0.0
