# ============================================================
# Dev-only Dockerfile for the React/Vite frontend
# Used by docker-compose with the `dev` profile
# ============================================================
FROM node:20-slim AS dev

WORKDIR /app

COPY client/package*.json ./
RUN npm ci

COPY client/ .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
