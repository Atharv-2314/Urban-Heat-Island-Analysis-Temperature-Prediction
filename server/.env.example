# UHI Project — Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development         # development | production

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your deployed frontend URL (e.g. https://urban-heat.vercel.app)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Python inference service (optional — only needed for live simulator) ────────
PYTHON_API_URL=http://localhost:8001

# ─── Python binary (used by dataLoader to spawn Parquet reader) ─────────────────
# Leave blank to use the system default "python" / "python3".
# In CI/CD override to the full path if needed: /usr/bin/python3
PYTHON_BIN=
