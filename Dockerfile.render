# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.render  — Backend-only image for Render deployment
#
# Installs Node 20 + minimal Python (pandas + pyarrow) so the Express server
# can spawn the inline Python Parquet reader in dataLoader.ts.
# Does NOT install Streamlit, Matplotlib, Seaborn, or any dev tools.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      gcc \
      libgomp1 \
      gnupg \
   && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
   && apt-get install -y --no-install-recommends nodejs \
   && rm -rf /var/lib/apt/lists/*

# ── Python runtime (Parquet reader only) ─────────────────────────────────────
COPY server/requirements.prod.txt /tmp/requirements.prod.txt
RUN pip install --no-cache-dir -r /tmp/requirements.prod.txt

# ── Node server build ─────────────────────────────────────────────────────────
WORKDIR /app

# Install Node deps
COPY server/package*.json ./server/
RUN cd server && npm ci --omit=dev

# Copy TypeScript source & compile
COPY server/ ./server/
RUN cd server && npm run build

# ── Copy datasets & reports that the API reads at runtime ────────────────────
COPY data/processed/monthly_level/ ./data/processed/monthly_level/
COPY data/processed/rolling_results/ ./data/processed/rolling_results/
COPY models/ ./models/
COPY reports/ ./reports/

# ── Runtime environment ───────────────────────────────────────────────────────
ENV NODE_ENV=production
ENV PYTHON_BIN=python3

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

CMD ["node", "server/dist/index.js"]
